{
  "name": "grab",
  "displayName": "Grab",
  "description": "Grab context from VSCode for external AI tools — paths, code snippets, remote URLs",
  "version": "0.2.0",
  "publisher": "janne-waren",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "grab.pathWithLine",
        "title": "Grab: Path with Line"
      },
      {
        "command": "grab.fullPathWithLine",
        "title": "Grab: Full Path with Line"
      },
      {
        "command": "grab.path",
        "title": "Grab: Relative Path"
      },
      {
        "command": "grab.fullPath",
        "title": "Grab: Full Path"
      },
      {
        "command": "grab.allOpenPaths",
        "title": "Grab: All Open Paths"
      },
      {
        "command": "grab.codeWithContext",
        "title": "Grab: Code with Context"
      },
      {
        "command": "grab.symbolContext",
        "title": "Grab: Symbol Context"
      },
      {
        "command": "grab.diagnosticsFile",
        "title": "Grab: Diagnostics (File)"
      },
      {
        "command": "grab.diagnosticsAll",
        "title": "Grab: Diagnostics (All)"
      },
      {
        "command": "grab.remoteUrl",
        "title": "Grab: Remote URL"
      }
    ],
    "keybindings": [
      {
        "command": "grab.pathWithLine",
        "key": "ctrl+shift+alt+c",
        "mac": "cmd+shift+alt+c"
      },
      {
        "command": "grab.fullPathWithLine",
        "key": "ctrl+shift+alt+f",
        "mac": "cmd+shift+alt+f"
      },
      {
        "command": "grab.path",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r"
      },
      {
        "command": "grab.fullPath",
        "key": "ctrl+shift+alt+a",
        "mac": "cmd+shift+alt+a"
      },
      {
        "command": "grab.allOpenPaths",
        "key": "ctrl+shift+alt+o",
        "mac": "cmd+shift+alt+o"
      },
      {
        "command": "grab.codeWithContext",
        "key": "ctrl+shift+alt+x",
        "mac": "cmd+shift+alt+x"
      },
      {
        "command": "grab.symbolContext",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s"
      },
      {
        "command": "grab.diagnosticsFile",
        "key": "ctrl+shift+alt+d",
        "mac": "cmd+shift+alt+d"
      },
      {
        "command": "grab.diagnosticsAll",
        "key": "ctrl+shift+alt+e",
        "mac": "cmd+shift+alt+e"
      },
      {
        "command": "grab.remoteUrl",
        "key": "ctrl+shift+alt+g",
        "mac": "cmd+shift+alt+g"
      }
    ],
    "configuration": {
      "title": "Grab",
      "properties": {
        "grab.defaultPathStyle": {
          "type": "string",
          "default": "relative",
          "enum": [
            "relative",
            "absolute"
          ],
          "description": "Default path style for copy operations"
        },
        "grab.openPathsSeparator": {
          "type": "string",
          "default": "\n",
          "description": "Separator for the Copy All Open Paths command"
        },
        "grab.statusBarMessageDuration": {
          "type": "number",
          "default": 2000,
          "description": "Duration in milliseconds for status bar feedback messages"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^18.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
