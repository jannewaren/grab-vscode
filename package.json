{
  "name": "grab",
  "displayName": "Grab",
  "description": "Grab context from VSCode for external AI tools — paths, code snippets, remote URLs",
  "version": "0.4.0",
  "publisher": "jannewaren",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "grab.pathWithLine",
        "title": "Grab: Relative Path with Line"
      },
      {
        "command": "grab.fullPathWithLine",
        "title": "Grab: Full Path with Line"
      },
      {
        "command": "grab.path",
        "title": "Grab: Relative Path"
      },
      {
        "command": "grab.fullPath",
        "title": "Grab: Full Path"
      },
      {
        "command": "grab.allOpenPaths",
        "title": "Grab: All Open Paths"
      },
      {
        "command": "grab.codeWithContext",
        "title": "Grab: Code with Context"
      },
      {
        "command": "grab.symbolContext",
        "title": "Grab: Symbol Context"
      },
      {
        "command": "grab.diagnosticsFile",
        "title": "Grab: Diagnostics (File)"
      },
      {
        "command": "grab.diagnosticsAll",
        "title": "Grab: Diagnostics (All)"
      },
      {
        "command": "grab.remoteUrl",
        "title": "Grab: Remote URL"
      },
      {
        "command": "grab.remoteUrlWithLine",
        "title": "Grab: Remote URL with Line"
      }
    ],
    "keybindings": [
      {
        "command": "grab.pathWithLine",
        "key": "ctrl+shift+alt+c",
        "mac": "cmd+shift+alt+c"
      },
      {
        "command": "grab.codeWithContext",
        "key": "ctrl+shift+alt+x",
        "mac": "cmd+shift+alt+x"
      }
    ],
    "walkthroughs": [
      {
        "id": "grab.getStarted",
        "title": "Get Started with Grab",
        "description": "Copy paths, code, and context from VSCode for external AI tools.",
        "steps": [
          {
            "id": "grab.walkthrough.pathWithLine",
            "title": "Copy a Relative Path with Line Number",
            "description": "Place your cursor on any line and press **Cmd+Shift+Alt+C** (Mac) or **Ctrl+Shift+Alt+C** (Windows/Linux) to copy the relative path with line number.\n\nPaste into any AI tool to give it precise file context.\n\n[Try it now](command:grab.pathWithLine)",
            "media": {
              "markdown": "media/step-path-with-line.md"
            },
            "completionEvents": [
              "onCommand:grab.pathWithLine"
            ]
          },
          {
            "id": "grab.walkthrough.codeWithContext",
            "title": "Grab Code with Context",
            "description": "Select some code and press **Cmd+Shift+Alt+X** (Mac) or **Ctrl+Shift+Alt+X** (Windows/Linux) to copy a fenced markdown block with the file path.\n\nPerfect for pasting into ChatGPT, Claude, or any AI assistant.\n\n[Try it now](command:grab.codeWithContext)",
            "media": {
              "markdown": "media/step-code-with-context.md"
            },
            "completionEvents": [
              "onCommand:grab.codeWithContext"
            ]
          },
          {
            "id": "grab.walkthrough.moreShortcuts",
            "title": "Add More Shortcuts",
            "description": "Grab has 8 more commands without default shortcuts. Add your own keybindings for the ones you use most.\n\n[Open Keyboard Shortcuts](command:workbench.action.openGlobalKeybindings)",
            "media": {
              "markdown": "media/step-more-shortcuts.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Grab",
      "properties": {
        "grab.defaultPathStyle": {
          "type": "string",
          "default": "relative",
          "enum": [
            "relative",
            "absolute"
          ],
          "description": "Default path style for copy operations"
        },
        "grab.openPathsSeparator": {
          "type": "string",
          "default": "\n",
          "description": "Separator for the Copy All Open Paths command"
        },
        "grab.statusBarMessageDuration": {
          "type": "number",
          "default": 2000,
          "description": "Duration in milliseconds for status bar feedback messages"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^18.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
